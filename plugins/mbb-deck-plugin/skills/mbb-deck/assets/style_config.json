    "body_pt": 14,
    "bullet_pt": 16,
    "footnote_pt": 9,
    "exec_summary_title_pt": 20,
    "exec_summary_point_pt": 14,
    "title_slide_main_pt": 36,
    "title_slide_subtitle_pt": 20,
    "title_slide_meta_pt": 12
  },
  "spacing": {
    "title_top_in": 0.4,
    "title_height_in": 0.9,
    "framing_line_height_in": 0.4,
