{
  "$schema": "Visual style configuration for MBB-style decks. Used by scripts/build_deck.py.",
  "slide": {
    "width_in": 13.333,
    "height_in": 7.5,
    "margin_in": 0.5
  },
  "typography": {
    "body_font": "Calibri",
    "title_font": "Calibri",
    "action_title_pt": 24,
    "action_title_bold": true,
    "framing_line_pt": 12,
